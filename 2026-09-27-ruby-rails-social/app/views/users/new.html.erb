<h1>Sign up</h1>

<%= render "shared/errors", object: @user %>

<%= form_with model: @user do |f| %>
  <%= f.label :username %>
  <%= f.text_field :username %>

  <%= f.label :email %>
  <%= f.email_field :email %>

  <%= f.label :password %>
  <%= f.password_field :password %>

  <%= f.submit "Create account" %>
<% end %>
