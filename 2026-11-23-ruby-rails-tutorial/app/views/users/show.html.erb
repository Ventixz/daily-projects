<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-sidebar">
    <section class="user_info">
      <h1><%= gravatar_for @user %> <%= @user.name %></h1>
    </section>
    <section class="stats">
      <%= render "shared/stats", user: @user %>
    </section>
  </aside>
  <div class="col-main">
    <%= render "follow_form" if logged_in? %>
    <% if @user.microposts.any? %>
      <h3>Microposts (<%= @user.microposts.count %>)</h3>
      <ol class="microposts">
        <%= render partial: "microposts/micropost", collection: @microposts.records %>
      </ol>
      <%= pagination_links(@microposts) %>
    <% end %>
  </div>
</div>
