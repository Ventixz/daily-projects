{ odd, and/or/not, every comparison, else, and the dangling else. }
var x;
begin
    x := 5;
    if odd x then writeInt 1 else writeInt 0;
    if odd -4 then writeInt 1 else writeInt 0;
    if x > 1 and x < 10 then writeInt 2;
    if x = 1 or x = 5 then writeInt 3;
    if not x = 5 then writeInt 99 else writeInt 4;
    if x # 5 then writeInt 99;
    if x >= 5 and x <= 5 then writeInt 5;
    if not (x + 1) < 3 and not odd 2 then writeInt 6;
    { dangling else binds to the inner if }
    if x > 0 then if x > 10 then writeInt 99 else writeInt 7;
    if x < 0 then if x > 10 then writeInt 99 else writeInt 98
end.
