{ Arrays: fill with a pseudo-random sequence, bubble sort, print. }
const n = 8;
var a size n, i, j, t, seed;
begin
    seed := 42;
    i := 0;
    while i < n do
    begin
        seed := (seed * 1103515245 + 12345) % 2147483648;
        a[i] := seed % 100;
        i := i + 1
    end;
    i := 0;
    while i < n - 1 do
    begin
        j := 0;
        while j < n - 1 - i do
        begin
            if a[j] > a[j + 1] then
            begin
                t := a[j]; a[j] := a[j + 1]; a[j + 1] := t
            end;
            j := j + 1
        end;
        i := i + 1
    end;
    i := 0;
    while i < n do begin writeInt a[i]; i := i + 1 end
end.
