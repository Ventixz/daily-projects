// Each call to makeCounter closes over its own `count` — the two counters
// below don't share state, even though they're built from the same function.
fun makeCounter() {
  var count = 0;
  fun increment() {
    count = count + 1;
    return count;
  }
  return increment;
}

var a = makeCounter();
var b = makeCounter();

print a(); // 1
print a(); // 2
print a(); // 3
print b(); // 1 - independent from a
