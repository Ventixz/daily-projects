@page "/wiki/new"
@model CoreWiki.Pages.Wiki.NewModel
@{
    ViewData["Title"] = "New page";
}

<h1>New page</h1>

<form method="post">
    <div asp-validation-summary="All" class="errors"></div>

    <label for="Title">Title</label>
    <input asp-for="Title" autofocus />

    <label for="Body">Content (Markdown)</label>
    <textarea asp-for="Body" rows="16"></textarea>

    <button type="submit">Create</button>
</form>
